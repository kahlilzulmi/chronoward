{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "notification:default",
    "chronoward-tracking:default",
    "allow-insert-app-usage",
    "allow-get-aggregated-usage",
    "allow-google-auth-status",
    "allow-google-sign-in",
    "allow-google-complete-sign-in",
    "allow-google-cancel-sign-in",
    "allow-google-sign-out",
    "allow-google-sync-drive",
    "allow-google-merge-usage-jsonl",
    "allow-start-pairing-mode",
    "allow-stop-pairing-mode",
    "allow-show-windows-timer-toast",
    "allow-clear-windows-toast",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-set-always-on-top"
  ]
}
# Supabase (Phase 5) — copy to .env and fill in
# Project URL from Settings → API (NOT db.YOUR_REF.supabase.co)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# anon public key only — NEVER the service_role secret
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# PowerSync instance URL (Phase 5.3+; unused until Rust plugin is unblocked)
VITE_POWERSYNC_URL=https://YOUR_INSTANCE.powersync.journeyapps.com
